<xrobot version="0.1">

    <geometry type="step" path="../examples/simple_model.step" resolution = "0.00001"/>

    <part name="Base_link"
    density="2700"
    rgba="0.7 0.0 0.0 1.0">
    </part>

    <part name="Part2"
    mass="1.0"
    </part>

    <joint
        name="jR23"
        type="revolute"

        parent="Base_link"
        child="Part2"

        px="0"
        py="0"
        pz="0.015"

        axisX="0"
        axisY="0"
        axisZ="1"

        kLinear="10000"
        kAngular="10000"

        dLinear="100"
        dAngular="100"

        linearTolerance="0.0001"
        angularTolerance="0.001"

        lowerLimit="-1.57"
        upperLimit="1.57"
    />
</xrobot>