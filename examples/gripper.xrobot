<xrobot version="0.1" name="xrobot10">

    <geometry type="step" path="../examples/simple_model.step" resolution = "0.00001"/>

    <part name="Base_link"
    density="2700"
    rgba="0.7 0.0 0.0 1.0">
    </part>

    <part name="Part2"
    density="2700">
    </part>

    <joint
        name="j1"
        type="prismatic"

        control="position"

        parent="Part2"
        child="Base_link"

        px="0"
        py="0"
        pz="0.01"

        axisX="1"
        axisY="0"
        axisZ="0"

        kLinear="10000"
        kAngular="1"

        dLinear="10"
        dAngular="0.003"

        linearTolerance="0.0001"
        angularTolerance="0.001"

        lowerLimit="0.0"
        upperLimit="0.2"

        speed="1.0"
        effort="1"
    />
</xrobot>
